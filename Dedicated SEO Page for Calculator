<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Free Online Scientific Calculator - Fast & Accurate</title>
    <meta name="description" content="Online scientific calculator supporting sin, cos, tan, log, square root, and complex mathematical calculations directly in your browser.">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased">

    <header class="bg-white border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
            <a href="index.html" class="text-xl font-bold text-indigo-600">⚡ ToolsPortal</a>
            <a href="index.html" class="text-sm font-medium text-slate-600 hover:text-indigo-600">← Back to All Tools</a>
        </div>
    </header>

    <main class="max-w-xl mx-auto px-4 py-12">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-extrabold text-slate-900 mb-2">Online Scientific Calculator</h1>
            <p class="text-slate-600">Advanced mathematical calculations directly in browser.</p>
        </div>

        <div class="bg-slate-900 p-6 rounded-3xl shadow-xl border border-slate-800">
            <input type="text" id="calcDisplay" readonly value="0" class="w-full bg-slate-800 text-right text-3xl font-mono text-green-400 p-4 rounded-xl mb-4 focus:outline-none">

            <div class="grid grid-cols-4 gap-2 text-white font-bold">
                <button onclick="calcClear()" class="p-3 bg-red-600 hover:bg-red-700 rounded-xl">C</button>
                <button onclick="calcDelete()" class="p-3 bg-slate-700 hover:bg-slate-600 rounded-xl">DEL</button>
                <button onclick="calcInput('(')" class="p-3 bg-slate-700 hover:bg-slate-600 rounded-xl">(</button>
                <button onclick="calcInput(')')" class="p-3 bg-slate-700 hover:bg-slate-600 rounded-xl">)</button>

                <button onclick="calcInput('sin(')" class="p-3 bg-slate-800 hover:bg-slate-700 text-indigo-400 rounded-xl">sin</button>
                <button onclick="calcInput('cos(')" class="p-3 bg-slate-800 hover:bg-slate-700 text-indigo-400 rounded-xl">cos</button>
                <button onclick="calcInput('tan(')" class="p-3 bg-slate-800 hover:bg-slate-700 text-indigo-400 rounded-xl">tan</button>
                <button onclick="calcInput('/')" class="p-3 bg-indigo-600 hover:bg-indigo-700 rounded-xl">÷</button>

                <button onclick="calcInput('7')" class="p-3 bg-slate-800 hover:bg-slate-700 rounded-xl">7</button>
                <button onclick="calcInput('8')" class="p-3 bg-slate-800 hover:bg-slate-700 rounded-xl">8</button>
                <button onclick="calcInput('9')" class="p-3 bg-slate-800 hover:bg-slate-700 rounded-xl">9</button>
                <button onclick="calcInput('*')" class="p-3 bg-indigo-600 hover:bg-indigo-700 rounded-xl">×</button>

                <button onclick="calcInput('4')" class="p-3 bg-slate-800 hover:bg-slate-700 rounded-xl">4</button>
                <button onclick="calcInput('5')" class="p-3 bg-slate-800 hover:bg-slate-700 rounded-xl">5</button>
                <button onclick="calcInput('6')" class="p-3 bg-slate-800 hover:bg-slate-700 rounded-xl">6</button>
                <button onclick="calcInput('-')" class="p-3 bg-indigo-600 hover:bg-indigo-700 rounded-xl">-</button>

                <button onclick="calcInput('1')" class="p-3 bg-slate-800 hover:bg-slate-700 rounded-xl">1</button>
                <button onclick="calcInput('2')" class="p-3 bg-slate-800 hover:bg-slate-700 rounded-xl">2</button>
                <button onclick="calcInput('3')" class="p-3 bg-slate-800 hover:bg-slate-700 rounded-xl">3</button>
                <button onclick="calcInput('+')" class="p-3 bg-indigo-600 hover:bg-indigo-700 rounded-xl">+</button>

                <button onclick="calcInput('0')" class="p-3 bg-slate-800 hover:bg-slate-700 rounded-xl">0</button>
                <button onclick="calcInput('.')" class="p-3 bg-slate-800 hover:bg-slate-700 rounded-xl">.</button>
                <button onclick="calcInput('sqrt(')" class="p-3 bg-slate-800 hover:bg-slate-700 text-indigo-400 rounded-xl">√</button>
                <button onclick="calcCalculate()" class="p-3 bg-green-600 hover:bg-green-700 rounded-xl">=</button>
            </div>
        </div>
    </main>

    <script src="portal-core.js"></script>
</body>
</html>
